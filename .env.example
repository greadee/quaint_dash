DASHBOARD_DB_PATH=data/persistent_db.db
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8000
DASHBOARD_WEB_DEV_ORIGIN=http://127.0.0.1:5173

# Optional conservative background workers.
INGESTION_BACKGROUND_ENABLED=false
INGESTION_BACKGROUND_MAX_JOBS_PER_TICK=1
INGESTION_BACKGROUND_MAX_ASSETS_PER_SCHEDULE=25
INGESTION_BACKGROUND_SCHEDULE_INTERVAL_SECONDS=3600
INGESTION_BACKGROUND_RUN_INTERVAL_SECONDS=300
INGESTION_BACKGROUND_YEARS=10
INGESTION_BACKGROUND_PRICES_ONLY=false

# Optional startup broker sync. Do not put provider secrets in this template.
BROKER_SYNC_ON_SERVER_STARTUP=false
BROKER_SYNC_MAX_USERS=
BROKER_SYNC_MIN_AGE_HOURS=24
