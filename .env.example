DASHBOARD_DB_PATH=data/persistent_db.db
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8000
DASHBOARD_WEB_DEV_ORIGIN=http://127.0.0.1:5173

# Optional conservative background workers.
INGESTION_BACKGROUND_ENABLED=false
INGESTION_BACKGROUND_MAX_JOBS_PER_TICK=1
INGESTION_BACKGROUND_MAX_ASSETS_PER_SCHEDULE=25
INGESTION_BACKGROUND_SCHEDULE_INTERVAL_SECONDS=3600
INGESTION_BACKGROUND_RUN_INTERVAL_SECONDS=300
INGESTION_BACKGROUND_YEARS=10
INGESTION_BACKGROUND_PRICES_ONLY=false

# Optional current/EOD market freshness worker.
# When enabled, this polls recent provider daily bars for tracked assets, updates
# current prices, and repairs the canonical daily close table.
MARKET_FRESHNESS_ENABLED=false
MARKET_FRESHNESS_POLL_INTERVAL_SECONDS=900
MARKET_FRESHNESS_INCLUDE_WATCHLIST=false
MARKET_FRESHNESS_LOOKBACK_DAYS=7
MARKET_FRESHNESS_MAX_SYMBOLS_PER_TICK=10

# Optional retail sentiment providers. Leave unset to keep providers disabled.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_SUBREDDITS=stocks,investing,wallstreetbets,SecurityAnalysis
REDDIT_POST_LIMIT=25
REDDIT_REQUEST_TIMEOUT_SECONDS=10
X_BEARER_TOKEN=
X_POST_LIMIT=25
X_REQUEST_TIMEOUT_SECONDS=10
X_INCLUDE_PLAIN_TICKER=false

# Optional startup broker sync. Do not put provider secrets in this template.
BROKER_SYNC_ON_SERVER_STARTUP=false
BROKER_SYNC_MAX_USERS=
BROKER_SYNC_MIN_AGE_HOURS=24
