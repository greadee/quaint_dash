  }

  BENCHMARK_INDEX_DAILY_METRIC {
    TEXT index_id PK, FK
    DATE metric_date PK
    DOUBLE return_1d
    DOUBLE return_5d
    DOUBLE return_21d
    DOUBLE return_63d
    DOUBLE return_126d
    DOUBLE return_252d
