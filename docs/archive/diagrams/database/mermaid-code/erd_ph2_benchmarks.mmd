  BENCHMARK_INDEX {
    TEXT index_id PK
    TEXT index_name
    TEXT index_family
    TEXT index_category
    TEXT region
    TEXT country_code
    TEXT currency
    BOOLEAN is_core
    BOOLEAN is_active
    TEXT notes
  }

  BENCHMARK_INDEX_SYMBOL {
    TEXT index_id PK, FK
    TEXT provider PK
    TEXT provider_symbol PK
    TEXT symbol_purpose PK
    BOOLEAN is_primary
    BOOLEAN is_proxy
  }

  BENCHMARK_INDEX_DAILY_PRICE {
    TEXT index_id PK, FK
    DATE price_date PK
    DOUBLE open
    DOUBLE high
    DOUBLE low
    DOUBLE close
    DOUBLE adj_close
    DOUBLE volume
    DOUBLE previous_close
    DOUBLE price_return_1d
    DOUBLE total_return_1d
    TEXT source
    TEXT source_symbol
    BOOLEAN is_proxy
  }

  BENCHMARK_INDEX_INTRADAY_PRICE {
    TEXT index_id PK, FK
    TEXT interval PK
    TIMESTAMP bar_start_utc PK
    DOUBLE open
    DOUBLE high
    DOUBLE low
    DOUBLE close
    DOUBLE volume
    TEXT source
    TEXT source_symbol
    BOOLEAN is_proxy
  }

  BENCHMARK_INDEX_COMPOSITION_SNAPSHOT {
    TEXT index_id PK, FK
    DATE snapshot_date PK
    TEXT source PK
    TEXT source_symbol
    TEXT source_type
    BOOLEAN is_proxy
    INTEGER constituent_count
    DOUBLE total_weight_pct
    TEXT data_quality
    TEXT notes
  }

  BENCHMARK_INDEX_CONSTITUENT {
    TEXT index_id PK, FK
    DATE snapshot_date PK
    TEXT source PK
    TEXT constituent_symbol PK
    TEXT constituent_name
    TEXT exchange_code
    TEXT country_code
    TEXT currency
    TEXT sector
    TEXT industry
    DOUBLE weight_pct
    DOUBLE market_cap
    BOOLEAN is_proxy
  }

  BENCHMARK_INDEX_EXPOSURE_SNAPSHOT {
    TEXT index_id PK, FK
    DATE snapshot_date PK
    TEXT dimension_type PK
    TEXT dimension_value PK
    TEXT source PK
    DOUBLE weight_pct
    TEXT source_type
